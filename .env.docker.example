APP_NAME="AI Mail Automation Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=secret
# Puerto en tu máquina (127.0.0.1) para clientes gráficos como HeidiSQL o DBeaver
DB_FORWARD_PORT=5433

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PASSWORD=secret
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=localhost:8080
SANCTUM_TOKEN_EXPIRATION=10080
SESSION_DOMAIN=localhost

LOG_CHANNEL=stack
# daily = texto (tail -f); json = el mismo log en JSON para Loki/Grafana (Fase 11).
LOG_STACK=daily,json
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
# Solo desarrollo: permite conectar a servidores de correo en la red interna (GreenMail).
# En producción debe quedar en false (protección anti-SSRF).
MAIL_CONNECTIONS_ALLOW_PRIVATE_HOSTS=true

# OAuth Microsoft 365 (registro de app en Azure / Entra ID).
# Redirect URI a registrar: APP_URL/api/v1/mail-connections/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# OAuth Google / Gmail (Google Cloud → OAuth client "Web application").
# Redirect URI a registrar: APP_URL/api/v1/mail-connections/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL del panel a la que volver tras autorizar OAuth (vacío = el callback responde JSON).
MAIL_CONNECTIONS_OAUTH_REDIRECT_TO=${APP_URL}/buzones

# --- IA (Fase 5) ---------------------------------------------------------
# Proveedor: anthropic (Claude real) o simulated (IA de PRUEBAS: reglas por
# palabras clave, sin API ni coste; solo en local). Con simulated se prueba
# el flujo completo y las métricas de Grafana sin gastar dinero.
AI_PROVIDER=anthropic
# Clave de la API de Anthropic (https://platform.claude.com). Vacía = IA
# desactivada: los emails se siguen guardando pero no se clasifican.
ANTHROPIC_API_KEY=
# Modelo (precios en config/ai.php). Más barato: claude-sonnet-5-5 o claude-haiku-4-5.
ANTHROPIC_MODEL=claude-opus-5-5
# Clasificar cada email al guardarlo.
# Procesar solo cada email al llegar (clasificación → agente → envío o revisión humana)
AI_PROCESS_ON_INGEST=true
# Freno de emergencia: false = nada se envía sin revisión humana, aunque la empresa esté en modo auto
AI_AUTO_SEND=true
# Freno del gasto: presupuesto diario por empresa en USD (vacío = sin límite;
# por empresa: php artisan ai:budget <id> --daily=25) y máximo de emails de un
# mismo remitente que pasan por la IA en 24 h (0 = sin límite).
AI_TENANT_DAILY_BUDGET_USD=10
AI_MAX_EMAILS_PER_SENDER=20

# --- Microservicio de IA en Python (ai-service) -------------------------
# Motor que procesa los emails: laravel (el de siempre, con RAG y tools) o
# python (ai-service por Redis Streams; ver ai-service/README.md).
AI_ENGINE=laravel
# Base de datos de Redis de los streams (el servicio usa la misma).
REDIS_STREAMS_DB=3
# Con AI_ENGINE=python, levantar también ai-service y ai-results (consumidor
# de resultados en Laravel). Usa ANTHROPIC_API_KEY y ANTHROPIC_MODEL de arriba.
#COMPOSE_PROFILES=ai-service
# Entorno del servicio (local permite la IA simulada y /debug/process).
AI_SERVICE_ENVIRONMENT=local
# anthropic (Claude real) o simulated (reglas por palabras clave, sin coste; solo local)
AI_SERVICE_LLM_PROVIDER=anthropic
# POST /debug/process en http://127.0.0.1:8001 (procesa un email de prueba)
AI_SERVICE_DEBUG_ENDPOINTS=false
# Contraseña del rol de PostgreSQL de solo lectura de ai-service (RAG con
# RLS por empresa). Lo crea la migración; en producción, una contraseña fuerte.
AI_SERVICE_DB_PASSWORD=reader-secret

# --- RAG / embeddings (Fase 6) -------------------------------------------
# Embeddings locales con Ollama (servicio "ollama" del docker-compose).
# Descargar el modelo una vez: docker compose exec ollama ollama pull bge-m3
OLLAMA_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=bge-m3

# --- Métricas para Prometheus (Fase 11) ---------------------------------
# Token que Prometheus envía a GET /metrics (Authorization: Bearer). Debe
# coincidir con docker/prometheus/prometheus.yml. Vacío = /metrics desactivado.
# En producción, un valor largo y aleatorio en ambos sitios.
METRICS_TOKEN=local-metrics-token

# --- Seguridad (Fase 12) -------------------------------------------------
# Todos los puertos se publican solo en 127.0.0.1. Para abrir la app a la
# red local: APP_BIND=0.0.0.0 (Prometheus, Loki y Grafana siguen en local:
# Prometheus y Loki no tienen usuario/contraseña).
APP_BIND=127.0.0.1
# Grafana: la contraseña solo se aplica la primera vez que arranca (después,
# docker compose exec grafana grafana cli admin reset-admin-password <nueva>).
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
# Detrás de un balanceador o proxy con HTTPS (producción): sus IPs separadas
# por comas, para que la auditoría y los límites vean la IP real del cliente.
# Vacío = no se confía en ninguno.
TRUSTED_PROXIES=
# Con HTTPS: la cookie de sesión solo viaja cifrada.
SESSION_SECURE_COOKIE=false
# Retención (php artisan data:prune cada noche): días de emails (cada
# empresa puede elegir otro) y de auditoría. 0 = sin límite.
RETENTION_EMAILS_DAYS=365
RETENTION_AUDIT_DAYS=730
# Antes de desplegar en producción: php artisan security:check
