{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-mail-automation.local/integrations/order.v1.schema.json",
  "title": "Pedido (API estándar v1)",
  "description": "Un pedido de un cliente. Campos desconocidos se ignoran (lector tolerante).",
  "type": "object",
  "required": ["number", "customer_email", "status"],
  "additionalProperties": true,
  "properties": {
    "number": {
      "description": "Número del pedido tal como lo conoce el cliente (\"45821\", \"ES-1234\").",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "customer_email": {
      "description": "Email del cliente que hizo el pedido. La plataforma comprueba que coincide con quien escribe.",
      "type": "string",
      "pattern": "^[^@\\s]+@[^@\\s]+$",
      "maxLength": 254
    },
    "status": {
      "type": "string",
      "enum": ["pending_payment", "processing", "shipped", "delivered", "cancelled", "returned"]
    },
    "placed_at": { "type": ["string", "null"], "format": "date-time" },
    "customer_name": { "type": ["string", "null"], "maxLength": 200 },
    "total": { "type": ["number", "null"], "minimum": 0 },
    "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["name", "quantity"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 300 },
          "quantity": { "type": "integer", "minimum": 1 },
          "unit_price": { "type": ["number", "null"], "minimum": 0 },
          "sku": { "type": ["string", "null"], "maxLength": 100 }
        }
      }
    },
    "shipment": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "carrier": { "type": ["string", "null"], "maxLength": 100 },
        "tracking_number": { "type": ["string", "null"], "maxLength": 100 },
        "tracking_url": { "type": ["string", "null"], "format": "uri", "pattern": "^https?://", "maxLength": 2000 },
        "shipped_at": { "type": ["string", "null"], "format": "date-time" },
        "estimated_delivery": { "type": ["string", "null"], "format": "date-time" },
        "delivered_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "shipping_city": { "type": ["string", "null"], "maxLength": 100 },
    "shipping_country": {
      "description": "Código ISO 3166-1 alfa-2. Nunca la dirección completa: no hace falta para responder.",
      "type": ["string", "null"],
      "pattern": "^[A-Z]{2}$"
    }
  }
}
