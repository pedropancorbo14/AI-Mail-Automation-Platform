{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-mail-automation.local/integrations/invoice-list.v1.schema.json",
  "title": "Lista de facturas de un cliente (API estándar v1)",
  "description": "De la más reciente a la más antigua, como máximo `limit`.",
  "type": "object",
  "required": ["data"],
  "additionalProperties": true,
  "properties": {
    "data": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "invoice.v1.schema.json" }
    }
  }
}
