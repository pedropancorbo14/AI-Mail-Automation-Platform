{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ai-mail-automation.local/events/document.deleted.v1.schema.json",
  "title": "document.deleted.v1",
  "description": "Laravel lo publica al borrar un documento (o por retención): ai-service borra sus fragmentos.",
  "type": "object",
  "properties": {
    "event_id": {
      "$ref": "common.schema.json#/$defs/event_id"
    },
