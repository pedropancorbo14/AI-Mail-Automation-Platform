      "const": "document.deleted"
    },
    "event_version": {
      "const": 1
    },
    "occurred_at": {
      "$ref": "common.schema.json#/$defs/occurred_at"
    },
    "trace_id": {
      "$ref": "common.schema.json#/$defs/trace_id"
    },
    "tenant_id": {
      "$ref": "common.schema.json#/$defs/tenant_id"
    },
    "document_id": {
      "$ref": "common.schema.json#/$defs/document_id"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "trace_id",
    "tenant_id",
    "document_id"
