          "expr": "label_replace(label_replace(label_replace(label_replace(round(sum by (purpose)(increase(aimail_ai_requests_total{tenant=~\"$tenant\"}[$__interval]))), \"p\", \"Clasificación\", \"purpose\", \"email_classification\"), \"p\", \"Agente\", \"purpose\", \"email_agent\"), \"p\", \"Búsqueda en documentación\", \"purpose\", \"knowledge_search\"), \"p\", \"Indexado de documentos\", \"purpose\", \"document_indexing\")",
