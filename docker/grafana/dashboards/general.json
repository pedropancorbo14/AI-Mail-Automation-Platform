            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(aimail_email_replies_sent_total{tenant=~\"$tenant\",automatic=\"true\"}[$__range])) / sum(increase(aimail_email_processing_seconds_count{tenant=~\"$tenant\",outcome!=\"ignored\"}[$__range]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
