    {
      "type": "stat",
      "title": "Tiempo ahorrado (estimado)",
      "description": "Respuestas enviadas solas × minutos que costaría escribirlas a mano (variable \"Minutos por respuesta manual\").",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
