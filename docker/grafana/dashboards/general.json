{
  "uid": "aimail-general",
  "title": "AI Mail · General",
  "description": "Resumen de la plataforma: volumen, automatización, personas, errores y coste.",
  "tags": [
    "ai-mail",
    "general"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Empresa",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(aimail_emails_current, tenant)",
          "refId": "tenant"
        },
        "definition": "label_values(aimail_emails_current, tenant)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "minutos",
        "label": "Minutos por respuesta manual",
        "type": "textbox",
        "query": "5",
        "current": {
          "text": "5",
          "value": "5"
        },
        "description": "Para estimar el tiempo ahorrado por cada respuesta enviada sola."
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "ai-mail"
      ],
      "asDropdown": true,
      "title": "Dashboards",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Periodo seleccionado",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Emails recibidos",
      "description": "Emails guardados por la ingesta (sin duplicados), incluidos los automáticos.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum(increase(aimail_emails_ingested_total{tenant=~\"$tenant\"}[$__range])))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
