      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(aimail_email_replies_sent_total{tenant=~\"$tenant\",automatic=\"true\"}[$__range])) * $minutos * 60",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
