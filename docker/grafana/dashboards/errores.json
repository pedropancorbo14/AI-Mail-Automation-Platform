    {
      "type": "logs",
      "title": "Errores",
      "description": "Log de Laravel (JSON). Despliega una línea para ver sus campos: context_* (detalle) y extra_* (tenant_id, request_id).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"laravel\", level=~\"ERROR|CRITICAL|ALERT|EMERGENCY\"} | json | line_format \"{{.message}}\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none",
        "showLabels": false,
        "showCommonLabels": false
