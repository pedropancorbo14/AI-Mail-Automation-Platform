      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(round(sum by (job_class) (increase(aimail_jobs_processed_total{result=\"failed\"}[$__range]))))",
          "legendFormat": "{{job_class}}",
          "range": false,
          "instant": true
