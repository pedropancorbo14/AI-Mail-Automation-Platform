          "expr": "label_replace(label_replace(label_replace(round(sum by (result) (increase(aiservice_events_total[$__interval]))), \"r\", \"Procesado\", \"result\", \"processed\"), \"r\", \"Fallido\", \"result\", \"failed|dead_lettered\"), \"r\", \"Reintento\", \"result\", \"retry\")",
