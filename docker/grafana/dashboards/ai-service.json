      "description": "ai:consume-results. stale = el email ya no esperaba (duplicado o tardío); tenant_mismatch nunca se aplica (alerta crítica).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(label_replace(label_replace(round(sum by (result) (increase(aimail_ai_remote_results_total[$__interval]))), \"r\", \"Aplicado\", \"result\", \"applied\"), \"r\", \"Descartado (duplicado o tardío)\", \"result\", \"stale|missing\"), \"r\", \"Cola de errores\", \"result\", \"invalid|tenant_mismatch|dead_lettered|retry\")",
          "legendFormat": "{{r}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
