{
  "uid": "aimail-costs",
  "title": "AI Mail · Costes",
  "description": "Gasto de la IA por día, mes, modelo, empresa y uso. Igual que la suma de ai_requests.cost_usd.",
  "tags": [
    "ai-mail",
    "costes"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Empresa",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(aimail_emails_current, tenant)",
          "refId": "tenant"
        },
        "definition": "label_values(aimail_emails_current, tenant)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
