    {
      "type": "bargauge",
      "title": "IA frenada por el plan",
      "description": "Emails que fueron a una persona sin IA por la suscripción (subscription) o por agotar los emails (plan_emails) o la capacidad de IA (plan_budget) del mes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort_desc(sum by (tenant, reason) (increase(aimail_ai_guard_blocks_total{reason=~\"subscription|plan_emails|plan_budget\",tenant=~\"$tenant\"}[$__range])))",
          "legendFormat": "{{tenant}} · {{reason}}",
          "range": false,
          "instant": true
