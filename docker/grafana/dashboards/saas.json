    {
      "type": "table",
      "title": "Uso de cada límite",
      "description": "Parte usada de cada límite del plan este mes (100 % = alcanzado). ai_budget_usd_per_month = gasto de IA frente al tope del plan.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (tenant, limit) (aimail_tenant_plan_usage_ratio{tenant=~\"$tenant\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "Sin datos",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Usado"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Usado",
            "desc": true
          }
        ],
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "tenant": "Empresa",
              "limit": "Límite"
            }
          }
        }
      ],
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 14,
        "h": 10
      }
    },
