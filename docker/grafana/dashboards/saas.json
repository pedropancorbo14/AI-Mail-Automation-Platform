{
  "uid": "aimail-saas",
  "title": "AI Mail · Planes y suscripciones",
  "description": "Empresas por plan y estado de la suscripción, uso de los límites del mes, pruebas que terminan y avisos de Stripe (Fase 17).",
  "tags": [
    "ai-mail",
    "saas"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Empresa",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(aimail_tenant_plan, tenant)",
          "refId": "tenant"
        },
        "definition": "label_values(aimail_tenant_plan, tenant)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "ai-mail"
      ],
      "asDropdown": true,
      "title": "Dashboards",
      "includeVars": true,
      "keepTime": true
    }
  ],
