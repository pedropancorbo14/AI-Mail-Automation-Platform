# Variables de producción / staging (Fase 16) para docker-compose.prod.yml.
#
# NO lo copies a mano: scripts/init-env.sh crea .env.production a partir de
# este fichero con todos los secretos aleatorios y la APP_KEY ya generados:
#   scripts/init-env.sh tu-dominio.example
# .env.production está en .gitignore: nunca se sube al repositorio. Guarda
# una copia en un gestor de contraseñas: sin APP_KEY no se pueden descifrar
# las credenciales de los buzones.
#
# Lo que el compose fija y aquí NO se cambia: APP_ENV=production, debug
# desactivado, APP_URL con https, cookies seguras, hosts internos, proxies de
# confianza y el anti-SSRF de los buzones.

APP_NAME="AI Mail Automation Platform"
# Dominio público (sin https://). Con "localhost", staging en tu equipo:
# HTTPS con un certificado local de Caddy (el navegador avisa).
APP_DOMAIN=__DOMAIN__
APP_KEY=__APP_KEY__
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# --- Base de datos y Redis ------------------------------------------------
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=__SECRET__
REDIS_PASSWORD=__SECRET__
REDIS_STREAMS_DB=3

SESSION_LIFETIME=120
SANCTUM_TOKEN_EXPIRATION=10080

# --- IA (ai-service) ------------------------------------------------------
# Clave de la API de Anthropic: la usa solo el contenedor ai-service.
ANTHROPIC_API_KEY=__ANTHROPIC_API_KEY__
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_CLASSIFY_MODEL=claude-haiku-5-5
ANTHROPIC_DRAFT_MODEL=
AI_SERVICE_LLM_PROVIDER=anthropic
AI_PROCESS_ON_INGEST=true
AI_AUTO_SEND=true
AI_MAX_EMAIL_AGE_DAYS=7
AI_TENANT_DAILY_BUDGET_USD=10
AI_MAX_EMAILS_PER_SENDER=20
OLLAMA_EMBEDDING_MODEL=bge-m3
# Tokens entre servicios (mismo valor lo usan Laravel y ai-service / ai-mcp).
AI_SERVICE_CHECKPOINTS_DB_PASSWORD=__SECRET__
AI_SERVICE_MCP_TOKEN=__SECRET__
AI_SERVICE_INTERNAL_TOKEN=__SECRET__
AI_SERVICE_DATA_TOKEN=__SECRET__

# --- Observabilidad -------------------------------------------------------
# Token de GET /metrics: Laravel lo exige y Prometheus lo envía (secreto
# metrics_token del compose).
METRICS_TOKEN=__SECRET__
GRAFANA_USER=admin
GRAFANA_PASSWORD=__SECRET__
# Operadores que pueden abrir /horizon (emails de usuarios del panel,
# separados por comas). Vacío = nadie.
HORIZON_ALLOWED_EMAILS=

# --- Avisos de las alertas (Alertmanager) -----------------------------------
# Email: cualquier SMTP. Gratis, p. ej. Gmail (smtp.gmail.com:587) con una
# "contraseña de aplicación" de tu cuenta (Cuenta de Google → Seguridad).
ALERT_EMAIL_TO=
ALERT_SMTP_HOST=
ALERT_SMTP_FROM=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_TLS=true
# Telegram (gratis): crea un bot con @BotFather (te da el token), escríbele
# un mensaje y saca tu chat_id de https://api.telegram.org/bot<token>/getUpdates
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# --- Copias de seguridad ----------------------------------------------------
# Hora (UTC) de la copia diaria y días que se guardan en el servidor.
BACKUP_TIME=03:15
BACKUP_KEEP_DAYS=14

# --- OAuth de buzones (opcional) -------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Retención ------------------------------------------------------------
RETENTION_EMAILS_DAYS=365
RETENTION_AUDIT_DAYS=730

# --- Planes y cobro (Fase 17) ----------------------------------------------
# Plan de las empresas que se dan de alta solas y días de prueba.
SAAS_DEFAULT_PLAN=trial
SAAS_TRIAL_DAYS=14
SAAS_PAST_DUE_GRACE_DAYS=7
# Cobro con Stripe (vacío = desactivado; el operador asigna planes con
# tenant:plan). Para probar sin dinero real, claves de modo de pruebas.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_BUSINESS=
