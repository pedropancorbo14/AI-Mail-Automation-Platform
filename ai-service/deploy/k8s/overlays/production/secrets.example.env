# Plantilla del Secret ai-service-secrets de producción. Copiar a secrets.env
# (ignorado por git), rellenar y crear el Secret:
#   kubectl -n aimail-ai create secret generic ai-service-secrets --from-env-file=secrets.env
# Mejor aún, con el gestor de secretos del clúster (External Secrets, Sealed
# Secrets...) apuntando a las mismas claves.

# Redis de la plataforma (base de datos de los streams, la misma que Laravel).
AI_SERVICE_REDIS_URL=redis://:CAMBIAR@redis.aimail-platform.svc.cluster.local:6379/3
# Clave de la API de Anthropic.
AI_SERVICE_ANTHROPIC_API_KEY=sk-ant-CAMBIAR
# Token entre ai-service y ai-mcp (largo y aleatorio: openssl rand -hex 32).
AI_SERVICE_MCP_TOKEN=CAMBIAR
# Token de la API interna que usa Laravel (el mismo AI_SERVICE_INTERNAL_TOKEN en Laravel).
AI_SERVICE_INTERNAL_TOKEN=CAMBIAR
# Rol de solo lectura del RAG (con RLS por empresa) en la BD de Laravel.
AI_SERVICE_DATABASE_URL=postgresql+psycopg://ai_service_reader:CAMBIAR@postgres.aimail-platform.svc.cluster.local:5432/app
# Rol de los checkpoints (solo su esquema ai_service) en la BD de Laravel.
AI_SERVICE_CHECKPOINT_DATABASE_URL=postgresql+psycopg://ai_service_checkpoints:CAMBIAR@postgres.aimail-platform.svc.cluster.local:5432/app
