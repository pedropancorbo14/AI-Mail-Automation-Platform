<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            <server> y no <env>: el contenedor "app" ya define APP_ENV,
            DB_DATABASE=app, QUEUE_CONNECTION=redis, etc. en $_SERVER, que es lo
            primero que lee Laravel. Con <env> (aunque sea force="true") esos
            valores ganarían y RefreshDatabase borraría la BD de desarrollo.
            Lo vigila tests/Feature/DatabaseConnectionTest.php.
        -->
        <server name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <server name="CACHE_STORE" value="array"/>
        <!-- Nunca llamar a la API de IA real desde los tests (aunque .env tenga clave). -->
        <server name="ANTHROPIC_API_KEY" value=""/>
        <!-- Ni la IA simulada del .env local: cada test elige su proveedor. -->
        <server name="AI_PROVIDER" value="anthropic"/>
        <!-- Motor de Laravel por defecto; los tests del motor remoto lo cambian. -->
        <server name="AI_ENGINE" value="laravel"/>
        <!-- Streams de los tests de Redis real (BD propia, se vacía en cada test). -->
        <server name="REDIS_STREAMS_DB" value="14"/>
        <server name="DB_CONNECTION" value="pgsql"/>
        <server name="DB_DATABASE" value="app_testing"/>
        <env name="DB_URL" value=""/>
        <server name="MAIL_MAILER" value="array"/>
        <!-- Métricas en memoria: cada test empieza de cero y no toca Redis. -->
        <server name="METRICS_STORAGE" value="memory"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="RAG_QUEUE_CONNECTION" value="sync"/>
        <server name="AI_QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
